<?xml version="1.0" ?>
<sdf version="1.6">
  <model name='agrover_trx4'>

    <!--
      Agrover TRX-4 rover model for PX4 SITL (Gazebo Harmonic).

      Geometry: primitives only (box body, cylinder wheels). No mesh files.
      Real TRX-4 dimensions: wheelbase 0.312 m, track 0.266 m.
      Mass: ~3.95 kg total. Auto-inertia via Gazebo Harmonic density system.
      Ride height: base_link at z=0.06 (wheel radius); body box offset 0.09 m
                   above link origin so bottom sits at 90 mm ground clearance.

      Steering: gz-sim-ackermann-steering-system (steering_only mode, servo_0).
      Drive:    4WD — JointController on command/motor_speed for all four wheels.

      PX4 / GZBridge contract (keep verbatim):
        - link name:    base_link
        - sensors:      imu_sensor, magnetometer_sensor, air_pressure_sensor, navsat_sensor
        - drive topic:  command/motor_speed, actuator 0, velocity control
        - steer topic:  servo_0, steering limit +-0.5236 rad
        - JointStatePublisher present
    -->

    <!-- ================================================================ -->
    <!-- Links                                                             -->
    <!-- ================================================================ -->

    <link name='base_link'>
      <!-- z=0.06 places base_link at wheel-centre height so wheels touch ground -->
      <pose relative_to='__model__'>0 0 0.06 0 0 0</pose>
      <inertial auto="true"/>
      <visual name='visual'>
        <!-- offset 0.09 m up so box bottom is at 90 mm above ground -->
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.18 0.12</size>
          </box>
        </geometry>
      </visual>

      <!-- Visual-only FRONT indicator (no collision, no density -> no effect on
           auto-inertia/mass). A red nose bar on the front-top edge so the front
           of the rover is obvious in sim. Front is +X. -->
      <visual name='front_marker'>
        <pose>0.21 0 0.155 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.14 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name='collision'>
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.18 0.12</size>
          </box>
        </geometry>
        <!-- density: 3.35 kg / (0.45*0.18*0.12 m^3) = 344.65 -> 345 kg/m^3 -->
        <density>345</density>
      </collision>

      <!-- ============================================================== -->
      <!-- Sensors — verbatim from rover_ackermann; names must not change  -->
      <!-- ============================================================== -->

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <!-- ============================================================== -->
      <!-- RealSense D435i-like RGBD camera — two separate sensors        -->
      <!-- (not rgbd_camera — avoids gz-sensors #545 frustum-offset bug)  -->
      <!-- Mount: x=0.23 y=0 z=0.16 in base_link frame, pitch=+0.262 rad -->
      <!--        (~15 deg nose-down, forward-facing, front-top of body)  -->
      <!-- ============================================================== -->

      <!-- Visual-only camera body box (no collision, no density ->
           no effect on auto-inertia / mass). Dark-grey slim bar
           representing the D435i housing (~25x90x25 mm). -->
      <visual name='d435i_body'>
        <pose>0.23 0 0.16 0 0.262 0</pose>
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- RGB camera — matches D435i color sensor optics (69.4 deg H-FOV).
           gz topic base: camera/rgb
           Published gz topics (a gz `camera` publishes the image on the bare
           <topic> itself, NOT <topic>/image — verified via gz topic -i):
             camera/rgb                (the image itself)
             camera/rgb/camera_info -->
      <sensor name="d435i_color" type="camera">
        <pose relative_to="base_link">0.23 0 0.16 0 0.262 0</pose>
        <topic>camera/rgb</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.2113</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- Depth camera — matches D435i depth sensor optics (87 deg H-FOV).
           USB 2.1 cap: 640x480 @ 30 fps.  Clip: 10.5 cm – 10 m (D435i range).
           gz topic base: camera/depth
           FOOTGUN: depth_camera publishes the raw depth image at the BASE topic
           itself (not <topic>/depth_image), plus /points and /camera_info.
           Published gz topics:
             camera/depth             (raw depth image — the base topic itself)
             camera/depth/points      (PointCloudPacked)
             camera/depth/camera_info -->
      <sensor name="d435i_depth" type="depth_camera">
        <pose relative_to="base_link">0.23 0 0.16 0 0.262 0</pose>
        <topic>camera/depth</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.105</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
      </sensor>

    </link>

    <!-- ============================================================== -->
    <!-- Rear wheels — real physics, high-grip drive wheels             -->
    <!-- ============================================================== -->

    <link name='wheel_rear_left_link'>
      <!-- pose: x=-0.156 (rear axle), y=+0.133 (left), z=0 (wheel centre = base_link z) -->
      <pose relative_to="base_link">-0.156 0.133 0 -1.5707 0 0</pose>
      <inertial auto="true"/>
      <visual name='visual'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <!-- density: 0.15 kg / (pi*0.06^2*0.08) = 165.79 -> 166 kg/m^3 -->
        <density>166</density>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='wheel_rear_right_link'>
      <!-- pose: x=-0.156 (rear axle), y=-0.133 (right), z=0 -->
      <pose relative_to="base_link">-0.156 -0.133 0 -1.5707 0 0</pose>
      <inertial auto="true"/>
      <visual name='visual'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <!-- density: 0.15 kg / (pi*0.06^2*0.08) = 165.79 -> 166 kg/m^3 -->
        <density>166</density>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ============================================================== -->
    <!-- Front steering intermediate links (carry the steering angle)   -->
    <!-- ============================================================== -->

    <link name="wheel_front_left_steering_link">
      <pose relative_to="wheel_front_left_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.0000018</ixx>
          <iyy>0.0000018</iyy>
          <izz>0.0000018</izz>
        </inertia>
      </inertial>
    </link>

    <link name="wheel_front_right_steering_link">
      <pose relative_to="wheel_front_right_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.0000018</ixx>
          <iyy>0.0000018</iyy>
          <izz>0.0000018</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ============================================================== -->
    <!-- Front wheels — real physics, moderate-grip steered wheels      -->
    <!-- ============================================================== -->

    <link name='wheel_front_left_link'>
      <!-- pose: x=+0.156 (front axle), y=+0.133 (left), z=0 -->
      <pose relative_to="base_link">0.156 0.133 0 -1.5707 0 0</pose>
      <inertial auto="true"/>
      <visual name='visual'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <!-- density: 0.15 kg / (pi*0.06^2*0.08) = 165.79 -> 166 kg/m^3 -->
        <density>166</density>
        <surface>
          <friction>
            <ode>
              <!-- Moderate friction to reduce lateral scrub during steering -->
              <mu>0.5</mu>
              <mu2>1.0</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='wheel_front_right_link'>
      <!-- pose: x=+0.156 (front axle), y=-0.133 (right), z=0 -->
      <pose relative_to="base_link">0.156 -0.133 0 -1.5707 0 0</pose>
      <inertial auto="true"/>
      <visual name='visual'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <!-- density: 0.15 kg / (pi*0.06^2*0.08) = 165.79 -> 166 kg/m^3 -->
        <density>166</density>
        <surface>
          <friction>
            <ode>
              <!-- Moderate friction to reduce lateral scrub during steering -->
              <mu>0.5</mu>
              <mu2>1.0</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ================================================================ -->
    <!-- Joints                                                            -->
    <!-- ================================================================ -->

    <joint name='wheel_rear_left_joint' type='revolute'>
      <pose relative_to='wheel_rear_left_link'/>
      <parent>base_link</parent>
      <child>wheel_rear_left_link</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <joint name='wheel_rear_right_joint' type='revolute'>
      <pose relative_to='wheel_rear_right_link'/>
      <parent>base_link</parent>
      <child>wheel_rear_right_link</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <!-- Front steering joints: axis z (in model frame), +-0.5236 rad limit, damped -->
    <joint name="wheel_front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_left_steering_link</child>
      <pose relative_to="wheel_front_left_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5236</lower>
          <upper>0.5236</upper>
          <effort>1e6</effort>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0</friction>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="wheel_front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_right_steering_link</child>
      <pose relative_to="wheel_front_right_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5236</lower>
          <upper>0.5236</upper>
          <effort>1e6</effort>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0</friction>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- Front wheel spin joints (child of the steering link, not base_link directly) -->
    <joint name='wheel_front_left_joint' type='revolute'>
      <pose relative_to='wheel_front_left_link'/>
      <parent>wheel_front_left_steering_link</parent>
      <child>wheel_front_left_link</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <joint name='wheel_front_right_joint' type='revolute'>
      <pose relative_to='wheel_front_right_link'/>
      <parent>wheel_front_right_steering_link</parent>
      <child>wheel_front_right_link</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================================================================ -->
    <!-- Plugins                                                           -->
    <!-- ================================================================ -->

    <!-- 4WD drive plugins — command/motor_speed actuator 0, velocity control -->
    <!-- verbatim contract: topic, actuator_number, control_type must not change -->

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_left_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_right_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_right_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_left_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>

    <!--
      Ackermann steering plugin — steering_only mode, reads PX4's servo_0.
      PX4's gz_bridge (GZMixingInterfaceServo) publishes the steering angle as a
      gz.msgs.Double on /model/<name>/servo_0. With steering_only=true +
      use_actuator_msg=FALSE, the plugin's <sub_topic> redirect subscribes its
      Double (steer-angle) callback to that topic, then computes the inner/outer
      geometric split for the two front steering joints.
      NOTE: use_actuator_msg=true would instead expect a gz.msgs.Actuators message
      on that topic — a type mismatch that silently drops every command (no steering).
      Does NOT manage drive joints (steering_only=true).
      Ref: gz-sim 8 AckermannSteering Configure() topic/callback selection.
    -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <steering_only>true</steering_only>
      <use_actuator_msg>false</use_actuator_msg>
      <sub_topic>servo_0</sub_topic>
      <left_steering_joint>wheel_front_left_steering_joint</left_steering_joint>
      <right_steering_joint>wheel_front_right_steering_joint</right_steering_joint>
      <wheel_base>0.312</wheel_base>
      <wheel_separation>0.266</wheel_separation>
      <kingpin_width>0.266</kingpin_width>
      <steering_limit>0.5236</steering_limit>
      <!-- Steering slew speed: the plugin commands steering-joint VELOCITY =
           steer_p_gain * angle_error. Default 1.0 is sluggish; 3.5 gives a
           responsive slew to the target angle (tuned by feel). -->
      <steer_p_gain>3.5</steer_p_gain>
    </plugin>

    <!-- Joint state publisher — only joints that exist in this model -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_front_right_steering_joint</joint_name>
      <joint_name>wheel_front_left_steering_joint</joint_name>
    </plugin>

    <!--
      OdometryPublisher — the canonical "watch the rover drive in RViz" source
      (ros_gz ROS 2 Interoperability docs + ros_gz_sim_demos vehicle.sdf).
      Publishes a clean odom -> base_link transform with the frame names set
      VERBATIM (no model-name scoping) as a gz.msgs.Pose_V on its tf_topic
      (default /model/<name>/pose), which the bridge maps to ROS /tf.  Combined
      with robot_state_publisher (base_link -> wheels from joint states), the
      full tree is  odom -> base_link -> wheels  — set RViz Fixed Frame to `odom`
      to watch the rover drive.

      We deliberately do NOT use PosePublisher: its link poses come out
      model-scoped (agrover_trx4_0/base_link) and disconnect from the URDF
      base_link tree.  OdometryPublisher's configured frames avoid that.

      Bridge target: /model/agrover_trx4_0/pose -> gz.msgs.Pose_V -> /tf
    -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
